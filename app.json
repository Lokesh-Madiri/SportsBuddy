{
  "expo": {
    "name": "SportsBuddy",
    "slug": "sportsbuddy",
    "owner": "nsky_26",
    "scheme": "sportsbuddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sportsbuddy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SportsBuddy uses your location to find nearby games and events.",
        "NSLocationAlwaysUsageDescription": "SportsBuddy uses your location to find nearby games and events.",
        "NSUserNotificationsUsageDescription": "SportsBuddy sends match reminders, chat alerts, and event updates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.nsky26.sportsbuddy",
      "googleServicesFile":"${GOOGLE_SERVICES_JSON}",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#beff00",
          "sounds": [],
          "iosPermissions": {
            "allowAlert": true,
            "allowBadge": true,
            "allowSound": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow SportsBuddy to use your location to find nearby games."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "3f50f4a9-bb99-4464-ad6c-0fa346fe6cc4"
      }
    }
  }
}
